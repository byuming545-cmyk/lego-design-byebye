# Store generated CSV canonically while preserving Windows-friendly checkouts.
artifacts/**/*.csv text eol=crlf
astra-handoff/**/*.csv text eol=crlf
artifacts/assembly-development/validation-logs/*.txt -text -whitespace
# Native library checksums refer to the original bytes, including CRLF.
data/parts-foundation/ldraw/files/** -text -whitespace
data/parts-foundation/shadow/files/** -text -whitespace
data/parts-foundation/ldraw/CA*.txt -text -whitespace
# Generated LDraw documents use the format's intentional CRLF line endings.
artifacts/assembly-development/models/**/model.ldr -text whitespace=cr-at-eol
artifacts/generation-expansion/models/**/model.ldr -text whitespace=cr-at-eol
# Preserve the exact captured test output and its recorded digest.
artifacts/generation-expansion/logs/*.txt -text -whitespace
artifacts/connector-grammar/logs/*.txt -text -whitespace
artifacts/connector-grammar/**/model.ldr -text whitespace=cr-at-eol
