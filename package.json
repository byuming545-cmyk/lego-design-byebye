{
  "name": "bricklab",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.5.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/api/server.ts --development",
    "dev:web": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "preview": "npm run build && node scripts/preview.mjs",
    "start": "node dist-server/api/server.js",
    "test": "vitest run",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:preview": "playwright test --config playwright.preview.config.ts",
    "benchmark:speed": "tsx src/cli/speed-benchmark.ts",
    "benchmark:automotive": "tsx src/cli/automotive-benchmark.ts",
    "report:parts": "tsx src/cli/parts-foundation-report.ts",
    "verify:assembly": "tsx src/cli/assembly-verify.ts",
    "smoke:assembly": "tsx src/cli/assembly-smoke.ts",
    "astra:case": "tsx src/cli/astra-case.ts",
    "astra:pack": "tsx src/cli/astra-pack.ts",
    "astra:check": "tsx src/cli/astra-check.ts",
    "audit:connections": "tsx src/cli/connection-parse-audit.ts",
    "verify:interfaces": "tsx src/cli/assembly-deferred.ts"
  },
  "dependencies": {
    "@fontsource/noto-sans-sc": "^5.2.9",
    "@fontsource/space-grotesk": "^5.2.10",
    "compression": "^1.8.2",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.3",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^5.0.5"
  }
}
