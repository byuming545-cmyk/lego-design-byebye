# Server only. Production auto requires a key; development auto may use mock.
# Set mock explicitly to run the synthetic demonstration in production.
INVENTORY_PROVIDER=auto
REBRICKABLE_API_KEY=
BRICKLAB_DATA_DIR=data
PORT=3001
# Single-origin preview port used by npm run preview (independent of PORT).
PREVIEW_PORT=3000
# Live inventory additionally requires HTTPS access to rebrickable.com.
# Never prefix the key with VITE_ or place it in frontend files.
