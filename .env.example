# Server only. Production auto requires a key; development auto may use mock.
# Set mock explicitly to run the synthetic demonstration in production.
INVENTORY_PROVIDER=auto
REBRICKABLE_API_KEY=
BRICKLAB_DATA_DIR=data
PORT=3001
# Single-origin preview port used by npm run preview (independent of PORT).
PREVIEW_PORT=3000
# Live inventory additionally requires HTTPS access to rebrickable.com.
# Never prefix the key with VITE_ or place it in frontend files.

# Vehicle research/vision. Zero budgets disable paid calls.
VEHICLE_VISION_PROVIDER=dashscope
DASHSCOPE_REGION=beijing
DASHSCOPE_VISION_MODEL=qwen3-vl-plus
DASHSCOPE_API_KEY=
VEHICLE_VISION_MAX_REQUESTS_PER_DAY=0
VEHICLE_VISION_DAILY_BUDGET_MICRO_USD=0
VEHICLE_VISION_RESERVE_MICRO_USD=0
# OpenAI is explicit opt-in only; no provider/key fallback.
# VEHICLE_OPENAI_MODEL=gpt-4.1-mini
